import streamlit as st
import pandas as pd

st.set_page_config(
    page_title="Pocket Option V5",
    page_icon="📈",
    layout="wide"
)

st.title("📈 Pocket Option V5")
st.caption("EMA + RSI strategy backtester — demo/testing only")

# Settings
st.sidebar.header("Strategy Settings")

ema_period = st.sidebar.number_input(
    "EMA Period",
    min_value=2,
    max_value=200,
    value=20
)

rsi_period = st.sidebar.number_input(
    "RSI Period",
    min_value=2,
    max_value=50,
    value=14
)

expiry = st.sidebar.number_input(
    "Expiry (minutes)",
    min_value=1,
    max_value=60,
    value=5
)

stake = st.sidebar.number_input(
    "Demo Stake",
    min_value=1.0,
    value=10.0
)

payout = st.sidebar.slider(
    "Payout %",
    min_value=50,
    max_value=100,
    value=80
)

daily_loss_limit = st.sidebar.number_input(
    "Daily Loss Limit",
    min_value=1.0,
    value=50.0
)

st.subheader("Upload price data")

uploaded_file = st.file_uploader(
    "Upload a CSV containing time, open, high, low and close",
    type=["csv"]
)

if uploaded_file is None:
    st.info("Upload a CSV to run the backtest.")
    st.markdown("""
### Expected CSV columns

Your CSV should contain:

- `time`
- `open`
- `high`
- `low`
- `close`
""")
    st.stop()

df = pd.read_csv(uploaded_file)

required = ["open", "high", "low", "close"]

missing = [col for col in required if col not in df.columns]

if missing:
    st.error(f"Missing columns: {', '.join(missing)}")
    st.stop()

# Convert prices
for col in required:
    df[col] = pd.to_numeric(df[col], errors="coerce")

df = df.dropna(subset=required).reset_index(drop=True)

# EMA
df["EMA"] = df["close"].ewm(
    span=ema_period,
    adjust=False
).mean()

# RSI
delta = df["close"].diff()

gain = delta.clip(lower=0)
loss = -delta.clip(upper=0)

avg_gain = gain.rolling(rsi_period).mean()
avg_loss = loss.rolling(rsi_period).mean()

rs = avg_gain / avg_loss.replace(0, 1e-10)

df["RSI"] = 100 - (100 / (1 + rs))

# Signals
df["Signal"] = ""

df.loc[
    (df["close"] > df["EMA"]) & (df["RSI"] >= 50),
    "Signal"
] = "CALL"

df.loc[
    (df["close"] < df["EMA"]) & (df["RSI"] < 50),
    "Signal"
] = "PUT"
