    y=df.loc[df["Signal"] == "CALL", "low"] * 0.999,
    mode="markers+text",
    marker=dict(symbol="arrow-up", size=14),
    text="CALL",
    textposition="bottom center",
    name="CALL"
))

fig.add_trace(go.Scatter(
    x=df.index[df["Signal"] == "PUT"],
    y=df.loc[df["Signal"] == "PUT", "high"] * 1.001,
    mode="markers+text",
    marker=dict(symbol="arrow-down", size=14),
    text="PUT",
    textposition="top center",
 
))
# Backtest
trades = []
balance = 1000.0
starting_balance = balance
loss_today = 0.0

for i in range(len(df) - expiry):
    signal = df.loc[i, "Signal"]

    if signal == "":
        continue

    if loss_today >= daily_loss_limit:
        break

    entry = df.loc[i, "close"]
    exit_price = df.loc[i + expiry, "close"]

    if signal == "CALL":
        win = exit_price > entry
    else:
        win = exit_price < entry

    if win:
        profit = stake * payout / 100
        balance += profit
    else:
        profit = -stake
        balance += profit
        loss_today += stake

    trades.append({
        "Index": i,
        "Signal": signal,
        "Entry": entry,
        "Exit": exit_price,
        "Result": "WIN" if win else "LOSS",
        "Profit": profit,
        "Balance": balance
    })

results = pd.DataFrame(trades)

if results.empty:
    st.warning("No trades were generated from this data.")
    st.stop()

# Statistics
total_trades = len(results)
wins = (results["Result"] == "WIN").sum()
losses = (results["Result"] == "LOSS").sum()

win_rate = wins / total_trades * 100
net_profit = balance - starting_balance

results["Peak"] = results["Balance"].cummax()
results["Drawdown"] = results["Peak"] - results["Balance"]

max_drawdown = results["Drawdown"].max()

# Display
c1, c2, c3, c4 = st.columns(4)

c1.metric("Trades", total_trades)
c2.metric("Win Rate", f"{win_rate:.2f}%")
c3.metric("Net Profit", f"${net_profit:.2f}")
c4.metric("Max Drawdown", f"${max_drawdown:.2f}")

st.subheader("Balance")

chart_data = results.set_index("Index")["Balance"]
st.line_chart(chart_data)

st.subheader("Trade History")

st.dataframe(
    results[
        [
            "Signal",
            "Entry",
            "Exit",
            "Result",
            "Profit",
            "Balance"
        ]
    ],
    use_container_width=True
)

csv = results.to_csv(index=False)

st.download_button(
    "⬇️ Download Trade Results",
    csv,
    "pocket_option_results.csv",
    "text/csv"
)

st.caption(
